<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Cosmic Match — Interactive Prototype</title><style>
:root{font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#f7efff;background:#09071a}*{box-sizing:border-box}body{margin:0;min-height:100dvh;background:radial-gradient(ellipse at 20% 0%,#362264 0%,transparent 46%),radial-gradient(ellipse at 100% 100%,#302052,transparent 50%),#09071a}button,input,select{font:inherit}button{cursor:pointer}.app{max-width:490px;margin:auto;min-height:100dvh;padding:22px 20px 100px;position:relative}.top{display:flex;align-items:center;justify-content:space-between;gap:12px}.brand{font-size:23px;font-weight:850;letter-spacing:-.8px}.brand b{color:#e5b5ff}.eyebrow{color:#c9b6eb;font-size:11px;letter-spacing:2.5px;text-transform:uppercase;font-weight:800}.orb{width:44px;height:44px;border:1px solid #8566bb;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,#67459b,#231739);font-size:23px}h1{font-size:30px;line-height:1.07;letter-spacing:-1px;margin:26px 0 7px}p{color:#c5b8dc;margin:0;line-height:1.5}.tabs{position:fixed;z-index:10;bottom:0;left:50%;transform:translateX(-50%);width:min(490px,100%);display:flex;justify-content:space-around;background:#171026ed;border-top:1px solid #513c6a;backdrop-filter:blur(16px);padding:12px 10px max(14px,env(safe-area-inset-bottom))}.tab{text-decoration:none;border:0;background:none;color:#9d8caf;min-width:90px;padding:5px;display:grid;gap:5px;justify-items:center;font-size:11px;font-weight:700}.tab span{font-size:23px}.tab.active{color:#e9bcff}.card{background:linear-gradient(150deg,#291b49,#17112b);border:1px solid #5b417f;border-radius:26px;overflow:hidden;box-shadow:0 24px 50px #07031175}.person{margin-top:24px;position:relative;height:365px;display:flex;align-items:end;background-size:cover;background-position:center}.person:after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,#100921 3%,transparent 65%)}.person-content{position:relative;z-index:1;padding:22px;width:100%}.name{font-size:30px;font-weight:800;letter-spacing:-1px}.location{font-size:13px;color:#ded4ec;margin-top:5px}.chips{display:flex;gap:7px;flex-wrap:wrap;margin-top:13px}.chip{font-size:11px;font-weight:750;border:1px solid #ba9cdd70;background:#4b3275c9;border-radius:30px;padding:7px 10px}.match-score{position:absolute;top:17px;right:15px;border-radius:30px;padding:9px 12px;background:#27143fdf;border:1px solid #e8beff8f;color:#eac9ff;font-weight:850;font-size:13px;z-index:2}.details{padding:18px 20px 20px}.subhead{font-weight:800;font-size:14px;color:#f3dcff;margin-bottom:6px}.note{font-size:13px;color:#cbbde0;line-height:1.5}.actions{display:flex;justify-content:center;gap:22px;margin-top:20px}.round{width:62px;height:62px;border-radius:50%;display:grid;place-items:center;font-size:27px;border:1px solid #70578d;background:#2b2043;color:#f5dfff}.round.like{background:linear-gradient(135deg,#b968f3,#f0a8d1);border:0;color:#2b143d;box-shadow:0 6px 25px #b968f33d}.section{margin-top:22px}.mini{display:flex;align-items:center;gap:13px;padding:13px;margin:11px 0;border:1px solid #5b417f;background:#241839;border-radius:20px}.avatar{height:66px;width:66px;flex-shrink:0;border-radius:15px;background-size:cover;background-position:center}.mini h3{margin:0 0 4px;font-size:17px}.mini p{font-size:12px}.pill{font-size:11px;color:#ecd1ff;background:#603b82;padding:5px 8px;border-radius:20px;white-space:nowrap;margin-left:auto}.form{display:grid;gap:12px;margin-top:22px}.field{display:grid;gap:6px;font-size:12px;font-weight:750;color:#d6c3ef}input,select{width:100%;border:1px solid #685083;background:#211532;color:white;border-radius:14px;padding:13px;outline:none}input:focus,select:focus{border-color:#d8a8fa}.cta{width:100%;border:0;border-radius:15px;background:linear-gradient(90deg,#bb78eb,#e5a4d8);color:#210e32;font-weight:850;padding:15px}.info{border:1px solid #655081;border-radius:16px;padding:14px;background:#302045;font-size:13px;line-height:1.5;color:#d7c6ec}.empty{padding:45px 12px;text-align:center}.toast{position:fixed;top:18px;left:50%;transform:translateX(-50%);width:max-content;max-width:calc(100% - 30px);border:1px solid #c5a0ed;border-radius:14px;background:#392251;color:white;padding:12px 17px;z-index:20;box-shadow:0 8px 30px #0008;display:none}.small{font-size:11px;color:#a994c2;margin-top:16px;text-align:center}.star{color:#d9acff} #matches,#profile,#stories{display:none}main:target{display:block!important}body:has(main:target) #discover:not(:target){display:none} [hidden]{display:none!important}

/* Keep the birthday picker identical in size to the other profile fields on iPhone Safari. */
.form{min-width:0}
.form .field{min-width:0;width:100%;grid-template-columns:minmax(0,1fr)}
.form .field input,.form .field select{display:block;box-sizing:border-box;width:100%;min-width:0;max-width:100%;height:48px;min-height:48px;margin:0;padding:0 13px;border-radius:14px;font-size:16px;line-height:normal}
.form .field input[type="date"]{-webkit-appearance:none;appearance:none;display:block;width:100%;min-width:0;max-width:100%;height:48px;min-height:48px;padding:0 13px;text-align:left;color-scheme:dark}
.form .field input[type="date"]::-webkit-date-and-time-value{text-align:left;min-height:1em}
.form .field input[type="date"]::-webkit-datetime-edit{padding:0}

/* Photos and business advertising */
#advertise{display:none}
.photo-panel,.sponsor,.ad-panel{margin-top:20px;padding:17px;border:1px solid #6b4e91;border-radius:20px;background:linear-gradient(145deg,#2b1b4a,#171025)}
.photo-panel h2,.ad-panel h2{margin:0 0 8px;font-size:19px}.photo-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin:13px 0}.photo-slot{aspect-ratio:1/1;border-radius:13px;border:1px dashed #b58ade;background:#211635;display:grid;place-items:center;color:#bb9bd7;font-size:13px;text-align:center;overflow:hidden;position:relative}.photo-slot:first-child{grid-column:span 2;grid-row:span 2}.photo-slot img{width:100%;height:100%;object-fit:cover}.photo-slot .slot-label{position:absolute;bottom:5px;left:5px;background:#160d27d9;border-radius:7px;padding:3px 6px;color:#fff;font-size:10px}.upload-label{display:block;text-align:center;border:1px solid #c18bed;background:#603486;color:#fff;font-weight:750;padding:12px;border-radius:13px;cursor:pointer}.upload-label input{position:absolute;width:1px;height:1px;opacity:0}.photo-help,.ad-note{font-size:12px;color:#c4b4de;margin:9px 0}.sponsor{padding:14px;margin-top:22px}.sponsor-tag{font-size:10px;letter-spacing:1.6px;color:#d2aae9;text-transform:uppercase;font-weight:800}.sponsor h3{margin:6px 0;font-size:17px}.sponsor a{color:#edc5ff}.ad-panel .field{display:grid;gap:7px;margin:13px 0;color:#e2d5f3;font-weight:650;font-size:13px}.ad-panel input,.ad-panel select,.ad-panel textarea{width:100%;min-width:0;box-sizing:border-box;min-height:48px;padding:12px;border:1px solid #694a8b;border-radius:14px;background:#1b1233;color:#fff;font:inherit;font-size:16px}.ad-panel textarea{min-height:80px}.ad-panel .cta{width:100%;margin-top:10px}.placement{border:1px solid #5f437c;border-radius:14px;padding:12px;margin:10px 0;background:#231739}.placement strong{display:block;margin-bottom:5px}.placement p{font-size:12px}.tabs .tab{min-width:0;flex:1}.tabs .tab span{font-size:20px}

/* Stories */
.story-controls{display:flex;gap:9px;margin:18px 0}.story-controls button{flex:1;border:1px solid #76599b;color:#dec5f5;background:#26173e;padding:11px 8px;border-radius:13px;font-size:13px}.story-controls button.active{background:#7540a3;color:white;border-color:#d09bec}.story-list{display:grid;gap:12px;margin-top:15px}.story-item{border:1px solid #674986;border-radius:20px;background:#231638;padding:15px;display:grid;gap:10px}.story-title{display:flex;align-items:center;gap:10px}.story-face{width:45px;height:45px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,#7f55bb,#3b215b);font-size:23px;border:2px solid #c18af5}.story-meta{font-size:12px;color:#cdb6de}.story-body{padding:18px;border-radius:14px;background:radial-gradient(circle at top right,#754aa5,#251638 75%);white-space:pre-wrap;overflow-wrap:anywhere;min-height:95px}.story-body img,.story-body video{display:block;width:100%;max-height:340px;object-fit:contain;border-radius:11px;margin-top:10px}.story-actions{display:flex;gap:8px;flex-wrap:wrap}.story-actions button,.secondary-btn{background:#51316d;color:#f4e7ff;border:1px solid #8665a4;padding:10px 12px;border-radius:12px;font-weight:700}.story-compose{display:grid;gap:12px;padding:17px;margin-top:20px;border-radius:19px;border:1px solid #624580;background:#211633}.story-compose textarea{width:100%;resize:vertical;min-height:85px;background:#1b102f;border:1px solid #6b518d;border-radius:12px;padding:12px;color:white;font:inherit}.story-compose label{font-size:13px;color:#e3d0fa}.story-compose select,.story-compose input[type=file]{margin-top:6px}.story-compose input[type=file]{font-size:12px}.story-views{margin-top:12px;border-top:1px solid #614879;padding-top:11px}.viewer{padding:10px 0;border-bottom:1px solid #463455;font-size:13px}.viewer strong{color:#f4d5ff}.viewer small{display:block;color:#c9b5df;margin-top:5px}.inline-reply{display:flex;gap:7px}.inline-reply input{min-width:0;flex:1}.inline-reply button{border:0;border-radius:12px;padding:0 12px;color:#271039;background:#d9a3ef;font-weight:750}.muted{font-size:12px;color:#c4addb}.setting-row{margin:15px 0;display:flex;gap:10px;align-items:center}.setting-row input[type=checkbox]{width:20px;height:20px;flex:none}.stat{font-weight:800;color:#efd2ff}.story-empty{padding:28px 14px;color:#c7b5dd;text-align:center;border:1px dashed #755793;border-radius:16px}.tabs .tab{font-size:10px;min-width:0;padding:4px 0}.tabs .tab span{font-size:19px}

/* Discover-first Stories strip */
.home-story-section{margin:20px 0 18px}.home-story-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px}.home-story-head strong{font-size:16px}.home-story-head button{border:0;background:none;color:#eac4ff;font-size:12px;font-weight:750;padding:7px}.home-story-row{display:flex;gap:15px;overflow-x:auto;padding:2px 2px 10px;scrollbar-width:none}.home-story-row::-webkit-scrollbar{display:none}.home-story{border:0;background:none;color:#f3e9ff;min-width:67px;width:67px;flex:0 0 67px;padding:0;display:grid;justify-items:center;gap:7px;text-align:center}.home-story-ring{width:64px;height:64px;border-radius:50%;padding:3px;background:linear-gradient(135deg,#eeb1ec,#a66df9,#6e56e9);box-shadow:0 4px 20px #b86ee72a}.home-story-ring > span{height:100%;width:100%;display:grid;place-items:center;border:3px solid #150c2b;border-radius:50%;font-size:27px;background:linear-gradient(145deg,#68419d,#261439)}.home-story-label{font-size:11px;font-weight:700;white-space:nowrap}.home-story-ring.mine{background:linear-gradient(135deg,#c7a4e6,#6c4e9a)}.swipe-intro{margin:6px 0 14px}.swipe-intro h1{font-size:27px;margin:0 0 6px}.swipe-intro p{font-size:13px}

.modebar{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:12px 0 16px}
.modebar button{border:1px solid #735b96;border-radius:12px;background:#302344;color:#e8d7ff;padding:12px 3px;font-size:12px;font-weight:700}
.modebar button.selected{background:#ae83ef;color:#1c1032;border-color:#ae83ef}
.business-panel{background:#2b203d;border:1px solid #685188;border-radius:16px;padding:16px;margin:18px 0}
.business-panel h2{margin:0 0 10px;font-size:19px}
.business-panel .field{margin:10px 0}
.business-panel input,.business-panel select,.business-panel textarea{width:100%;box-sizing:border-box}

/* Instagram-style Story creation */
.story-picker{position:fixed;inset:0;z-index:80;background:#070411b8;display:none;align-items:flex-end;justify-content:center;padding:16px;backdrop-filter:blur(7px)}
.story-picker.open{display:flex}.story-picker-sheet{width:min(490px,100%);border:1px solid #8964ac;border-radius:25px;background:linear-gradient(155deg,#372052,#181029);padding:22px;box-shadow:0 20px 60px #0009}
.story-picker-heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px}.story-picker-heading h2{margin:0;font-size:21px}.story-close{border:0;background:#ffffff16;color:white;border-radius:50%;width:34px;height:34px;font-size:22px}
.story-pick-action{display:flex;align-items:center;gap:15px;width:100%;text-align:left;color:#f9efff;background:#4c3270;border:1px solid #916bba;border-radius:17px;padding:16px;margin:10px 0;font-weight:750;font-size:15px}.story-pick-action span{font-size:27px}.story-pick-action small{display:block;font-size:12px;color:#d7c0eb;font-weight:400;margin-top:4px}
.story-media-preview{width:100%;max-height:340px;object-fit:contain;border-radius:15px;margin-top:9px;background:#120a20}.story-compose:not(.composer-open){display:none}

/* Prototype 18+ signup gate */
.age-gate{position:fixed;inset:0;z-index:1000;overflow:auto;display:grid;place-items:center;padding:20px;background:radial-gradient(ellipse at 20% 0%,#40236b,#09071a 65%)}
.age-gate[hidden]{display:none!important}.age-card{width:min(440px,100%);border:1px solid #78549c;background:linear-gradient(155deg,#301d50,#150e29);border-radius:26px;padding:26px;box-shadow:0 22px 65px #0009}.age-card h2{font-size:27px;margin:6px 0 10px}.age-card p{margin-bottom:18px}.age-card label{display:block;margin-top:14px;color:#ead8fc;font-size:13px;font-weight:700}.age-card input[type=checkbox]{width:auto;margin-right:8px;accent-color:#bb78eb}.age-card .age-error{color:#ffb6c5;min-height:20px;font-size:12px;margin:12px 0}.age-card .cta{margin-top:10px}.age-hint{font-size:12px;color:#bea8d7;margin-top:6px}
</style></head><body><div class="app"><div class="top"><div><div class="eyebrow">Find your frequency</div><div class="brand">✦ Cosmic <b>Match</b></div></div><div class="orb">☾</div></div><main id="discover"><div class="modebar" aria-label="Connection mode"><button type="button" data-mode="dating" onclick="setMode('dating')">♡ Dating</button><button type="button" data-mode="friendship" onclick="setMode('friendship')">✧ Friendship</button><button type="button" data-mode="business" onclick="setMode('business')">✦ Business</button></div><section class="home-story-section" aria-label="Stories"><div class="home-story-head"><strong>✦ Stories</strong><button type="button" onclick="openStoryHub('nearby')">See all Stories ›</button></div><div id="homeStoryRow" class="home-story-row"><button class="home-story" onclick="openStoryHub('mine')"><span class="home-story-ring mine"><span>＋</span></span><span class="home-story-label">Your Story</span></button><button class="home-story" onclick="openStoryHub('nearby')"><span class="home-story-ring"><span>🌎</span></span><span class="home-story-label">Public</span></button><button class="home-story" onclick="openStoryHub('nearby')"><span class="home-story-ring"><span>✈️</span></span><span class="home-story-label">Travel</span></button></div></section><div class="swipe-intro"><h1>Written in the stars <span class="star">✧</span></h1><p>Meet someone who aligns with your universe. Swipe to connect.</p></div><div id="profileCard" class="card"><div class="person" style="background:linear-gradient(140deg,#724aa2,#130b29)"><div class="person-content"><div class="name">Maya, 27</div><div class="location">⌖ Vancouver</div><div class="chips"><span class="chip">Pisces</span><span class="chip">Life path 7</span></div></div></div><div class="details"><div class="subhead">About Maya</div><div class="note">Creative soul, late-night talks and ocean sunsets.</div></div></div><div class="actions"><button class="round" title="Pass" onclick="vote(false)">✕</button><button class="round like" title="Like" onclick="vote(true)">♥</button></div><aside class="sponsor"><div class="sponsor-tag">Sponsored · Ad placement preview</div><h3>✧ Your brand could shine here</h3><p>Reach the Cosmic Match community with a featured promotion.</p><a href="#advertise" onclick="switchTab('advertise')">Explore advertising →</a></aside><div class="small">Demo profiles · Astrology and numerology are for reflection and fun.</div></main><main id="stories" hidden>
<h1>Nearby Stories ✦</h1><p>Discover people through their moments, not just their profile.</p>
<button type="button" class="cta" style="margin-top:18px" onclick="openStoryPicker()">＋ Add to Your Story</button><div class="story-controls"><button id="nearbyFilter" class="active" type="button" onclick="setStoryFilter('nearby')">⌖ Nearby</button><button id="matchesFilter" type="button" onclick="setStoryFilter('matches')">♥ Matches only</button><button id="mineFilter" type="button" onclick="setStoryFilter('mine')">☾ My stories</button></div>
<div id="storyFeed" class="story-list" aria-live="polite"></div>
<section class="story-compose" id="storyComposer"><h2 style="margin:0;font-size:19px">✦ Post a Story</h2><div class="muted">Public: maximum 2 per local calendar day. Matches-only posts are unlimited. Stories expire after 24 hours.</div><label>Caption<textarea id="storyCaption" maxlength="240" placeholder="What's your vibe today?"></textarea></label><div class="story-actions"><button type="button" class="secondary-btn" onclick="openStoryPicker()">📷 Change photo or video</button></div><div id="storyMediaPreview" class="muted">No media selected</div><div id="storyVisualPreview"></div><input hidden id="storyCamera" type="file" accept="image/*,video/*" capture="environment" onchange="chooseStoryMedia(this)"><input hidden id="storyGallery" type="file" accept="image/*,video/*" onchange="chooseStoryMedia(this)"><label>Who can see it?<select id="storyAudience"><option value="public">Public nearby</option><option value="matches">Matches only</option></select></label><div id="storyQuota" class="stat"></div><button class="cta" type="button" onclick="postStory()">Post Story ✦</button><div class="muted">Demo: Stories, views and replies are local to this browser. Media is not uploaded or saved across reloads. No real nearby accounts are shown.</div></section>
</main><div id="storyPicker" class="story-picker" role="dialog" aria-modal="true" aria-label="Add a Story"><div class="story-picker-sheet"><div class="story-picker-heading"><h2>✦ Add to your Story</h2><button type="button" class="story-close" onclick="closeStoryPicker()" aria-label="Close">×</button></div><button type="button" class="story-pick-action" onclick="pickStoryMedia('camera')"><span>📷</span><div>Camera<small>Take a new photo or video</small></div></button><button type="button" class="story-pick-action" onclick="pickStoryMedia('gallery')"><span>▧</span><div>Photo Library<small>Choose a saved photo or video</small></div></button><div class="muted" style="margin-top:13px">Choose your audience before sharing. Nothing posts automatically.</div></div></div><main id="matches"><h1>Your cosmic connections</h1><p>People you've liked appear here as demo matches.</p><div id="matchList" class="section"><div class="empty"><h2>No matches yet</h2><p>Open this file in Safari to activate likes and matches.</p></div></div><aside class="sponsor"><div class="sponsor-tag">Sponsored · Ad placement preview</div><h3>✧ Your brand could shine here</h3><p>Reach the Cosmic Match community with a featured promotion.</p><a href="#advertise" onclick="switchTab('advertise')">Explore advertising →</a></aside></main><main id="profile"><h1>Your constellation</h1><p>Set your details to explore your cosmic profile.</p><section class="photo-panel"><h2>✦ Your photos</h2><p>Add a main profile photo and up to five more photos.</p><div id="photoGrid" class="photo-grid"><div class="photo-slot">Main photo</div><div class="photo-slot">+</div><div class="photo-slot">+</div><div class="photo-slot">+</div><div class="photo-slot">+</div><div class="photo-slot">+</div></div><label class="upload-label">＋ Choose photos from your phone<input id="photoInput" type="file" accept="image/*" multiple onchange="previewPhotos(event)"></label><button type="button" class="upload-label" style="margin-top:9px;background:transparent" onclick="clearPhotos()">Remove photos</button><div class="photo-help">Demo only: photos preview on this device and are not uploaded to a server or shared with other people.</div></section><form class="form" onsubmit="saveProfile(event)"><label class="field">Your name<input id="yourName" maxlength="40" value="Alex" required></label><label class="field">Your birthday<input id="birthday" type="date" value="1996-07-15" required></label><label class="field">Your city<input id="city" value="Vancouver, BC"></label><label class="field">What are you seeking?<select id="seeking"><option>A meaningful connection</option><option>A serious relationship</option><option>Getting to know someone</option></select></label><div class="info" id="reading">✦ Your cosmic signature<br>Zodiac sign: <strong>Cancer</strong><br>Numerology life path: <strong>11</strong></div><button class="cta">Save my profile</button></form><section class="business-panel"><h2>✦ Separate business profile</h2><p>Visible only in Business mode. Your dating information stays private.</p><div class="photo-panel" style="margin:12px 0"><h3>Business gallery · up to 3 photos</h3><p class="muted">Add a logo, your work, products, or services. These are separate from your personal photos.</p><div id="businessPhotoGrid" class="photo-grid" style="grid-template-columns:repeat(3,1fr)"><div class="photo-slot">Main photo</div><div class="photo-slot">Photo 2</div><div class="photo-slot">Photo 3</div></div><label class="upload-label">＋ Choose up to 3 business photos<input id="businessPhotoInput" type="file" accept="image/*" multiple onchange="previewBusinessPhotos(event)"></label><button type="button" class="upload-label" style="margin-top:9px;background:transparent" onclick="clearBusinessPhotos()">Remove business photos</button><p class="photo-help">Photos are previewed locally and are not uploaded or retained after reloading this demo.</p></div><form id="businessForm" onsubmit="saveBusiness(event)">
<label class="field">Business name<input id="bizName" required placeholder="Your business"></label>
<label class="field">Industry<input id="bizIndustry" placeholder="Creative, technology, wellness..."></label>
<label class="field">Location<input id="bizLocation" placeholder="Vancouver, BC"></label>
<label class="field">About your business<textarea id="bizAbout" placeholder="What do you do?"></textarea></label>
<label class="field">Services<input id="bizServices" placeholder="Services or specialties"></label>
<label class="field">Website or social link<input id="bizLink" placeholder="https://"></label>
<label class="field">I'm looking for<select id="bizSeeking"><option>Collaborators</option><option>Clients</option><option>Business partners</option><option>Investors</option><option>Professional connections</option></select></label>
<button class="cta" type="submit">Save business profile</button></form></section><section class="photo-panel"><h2>☾ Story privacy</h2><label class="setting-row"><input type="checkbox" id="showNearby" checked onchange="saveStoryPrivacy()"><span>Show my public Stories in Nearby</span></label><div class="muted">Turn this off to opt out of Nearby. You can still post to matches only.</div><label class="setting-row"><input type="checkbox" id="allowReplies" checked onchange="saveStoryPrivacy()"><span>Allow private Story replies</span></label><div class="muted">Replies appear in your Story viewer list, without needing to open Messages. Only you can see them.</div></section><div class="small">Prototype only — changes are saved on this device.</div></main><main id="advertise"><h1>Advertise with Cosmic Match ✦</h1><p>Put your business in front of the right community. Choose where you want your sponsored message featured.</p><section class="ad-panel"><h2>Available ad spaces</h2><div class="placement"><strong>✧ Discover spotlight</strong><p>Sponsored card below the profile discovery area.</p></div><div class="placement"><strong>♥ Matches placement</strong><p>Sponsored card near the connections list.</p></div><div class="placement"><strong>☾ Featured campaign</strong><p>A promoted message across multiple sections of the app.</p></div><p class="ad-note">Placements are concepts for the prototype. Pricing and campaign availability will be set before launch.</p></section><section class="ad-panel"><h2>Request an advertisement</h2><form id="adRequest" onsubmit="submitAdRequest(event)"><label class="field">Business name<input id="adBusiness" required maxlength="70" placeholder="Your business"></label><label class="field">Email address<input id="adEmail" type="email" required placeholder="you@business.com"></label><label class="field">Where would you like to advertise?<select id="adPlacement"><option>Discover spotlight</option><option>Matches placement</option><option>Featured campaign</option></select></label><label class="field">Tell us about your ad<textarea id="adMessage" maxlength="500" placeholder="What do you want to promote?"></textarea></label><button class="cta" type="submit">Preview my advertising request</button></form><p id="adResponse" class="ad-note" role="status">This is a prototype. No request is sent and no payment is collected.</p></section></main><nav class="tabs"><a class="tab active" href="#discover" data-page="discover" onclick="switchTab('discover')"><span>✧</span>Discover</a><a class="tab" href="#stories" data-page="stories" onclick="switchTab('stories')"><span>◉</span>Stories</a><a class="tab" href="#matches" data-page="matches" onclick="switchTab('matches')"><span>♥</span>Matches</a><a class="tab" href="#profile" data-page="profile" onclick="switchTab('profile')"><span>☾</span>My Profile</a><a class="tab" data-page="advertise" href="#advertise" onclick="switchTab('advertise')"><span>✦</span>Advertise</a></nav></div><div class="toast" id="toast"></div><div id="ageGate" class="age-gate" role="dialog" aria-modal="true" aria-labelledby="ageTitle" hidden><form id="ageSignupForm" class="age-card"><div class="eyebrow">✦ Cosmic Match</div><h2 id="ageTitle">Your story starts here</h2><p>Cosmic Match is for adults aged <strong>18 or older</strong>. Enter your birthday to create your demo profile and calculate your cosmic signature.</p><label for="signupName">Your name</label><input id="signupName" maxlength="40" autocomplete="name" placeholder="Enter your name" required><label for="signupBirthday">Date of birth</label><input id="signupBirthday" type="date" autocomplete="bday" required><div class="age-hint">You must be at least 18 years old to sign up.</div><label><input id="signupAdultConfirm" type="checkbox" required> I confirm that I am at least 18 years old.</label><div id="signupAgeError" class="age-error" role="alert" aria-live="polite"></div><button class="cta" type="submit">Create my account ✦</button><div class="age-hint" style="margin-top:12px">Prototype only: this information stays in your browser. A real launch needs server-side age checks and enforcement.</div></form></div><script>
const people=[{name:'Maya',age:27,city:'Vancouver',sign:'Pisces',path:7,score:96,bio:'Creative soul, late-night talks and ocean sunsets.',insight:'Your shared curiosity makes space for deeper conversations.',colors:['#8e4ac0','#281d58'],emoji:'🌙'},{name:'Jordan',age:29,city:'Burnaby',sign:'Libra',path:3,score:93,bio:'Art, adventure, good food and honest conversation.',insight:'Your energies can bring warmth and playfulness to everyday moments.',colors:['#b0778c','#43305b'],emoji:'✨'},{name:'Sam',age:26,city:'North Vancouver',sign:'Taurus',path:6,score:91,bio:'Nature walks, live music and building something real.',insight:'You both value meaningful experiences and thoughtful connection.',colors:['#4c9aa3','#263964'],emoji:'🌿'},{name:'Riley',age:31,city:'Richmond',sign:'Scorpio',path:9,score:89,bio:'Big dreams, books, and spontaneous road trips.',insight:'A shared sense of purpose could spark inspiring conversations.',colors:['#aa6c8b','#402857'],emoji:'⭐'}];
let index=Number(localStorage.getItem('cm-index')||0);let liked=JSON.parse(localStorage.getItem('cm-liked')||'[]');let me=JSON.parse(localStorage.getItem('cm-me')||'null');function bg(p){return `radial-gradient(circle at 70% 20%,#ffffff2c,transparent 23%),radial-gradient(ellipse at 35% 45%,${p.colors[0]}bb,transparent 60%),linear-gradient(145deg,${p.colors[1]},#110b23)`};function zodiac(d){let m=d.getUTCMonth()+1,day=d.getUTCDate();let x=['Capricorn','Aquarius','Pisces','Aries','Taurus','Gemini','Cancer','Leo','Virgo','Libra','Scorpio','Sagittarius'];let cut=[20,19,21,20,21,21,23,23,23,23,22,22];return day>=cut[m-1]?x[m%12]:x[m-1]};function lifePath(s){let digits=s.replace(/\D/g,'');let n=digits.split('').reduce((a,b)=>a+Number(b),0);while(n>9&&n!==11&&n!==22&&n!==33)n=String(n).split('').reduce((a,b)=>a+Number(b),0);return n};function render(){let p=people[index%people.length];document.getElementById('profileCard').innerHTML=`<div class="person" style="background:${bg(p)}"><div style="position:absolute;top:70px;width:100%;text-align:center;font-size:100px;opacity:.65">${p.emoji}</div><div class="match-score">✦ ${p.score}% cosmic spark</div><div class="person-content"><div class="name">${p.name}, ${p.age}</div><div class="location">⌖ ${p.city}</div><div class="chips"><span class="chip">♈ ${p.sign}</span><span class="chip">✧ Life path ${p.path}</span><span class="chip">Looking for something real</span></div></div></div><div class="details"><div class="subhead">About ${p.name}</div><div class="note">${p.bio}</div><div class="subhead" style="margin-top:15px">✦ Why you might click</div><div class="note">${p.insight}</div></div>`;let arr=liked.map(i=>people[i]);document.getElementById('matchList').innerHTML=arr.length?arr.map(p=>`<div class="mini"><div class="avatar" style="background:${bg(p)};display:grid;place-items:center;font-size:32px">${p.emoji}</div><div><h3>${p.name}, ${p.age}</h3><p>${p.sign} · Life path ${p.path}</p></div><span class="pill">${p.score}% spark</span></div>`).join(''):'<div class="empty"><div style="font-size:52px">✦</div><h2>No matches yet</h2><p>Explore profiles and tap the heart to make a connection.</p></div>';let fields=me||{name:'Alex',birthday:'1996-07-15',city:'Vancouver, BC',seeking:'A meaningful connection'};for(let [key,id] of Object.entries({name:'yourName',birthday:'birthday',city:'city',seeking:'seeking'}))document.getElementById(id).value=fields[key];showReading()};function switchTab(s){for(let id of ['discover','stories','matches','profile','advertise'])document.getElementById(id).hidden=id!==s;document.querySelectorAll('.tab').forEach(b=>b.classList.toggle('active',b.dataset.page===s));if(s==='matches')render();if(s==='stories')renderStories();if(s==='discover')renderHomeStories()};function vote(yes){let id=index%people.length;if(yes&&!liked.includes(id)){liked.push(id);localStorage.setItem('cm-liked',JSON.stringify(liked));toast('✦ You liked '+people[id].name+'! Added to Matches.')}index++;localStorage.setItem('cm-index',index);render();renderHomeStories()};function toast(t){let e=document.getElementById('toast');e.textContent=t;e.style.display='block';clearTimeout(window.t);window.t=setTimeout(()=>e.style.display='none',2400)};function showReading(){let s=document.getElementById('birthday').value;if(!s)return;let sign=zodiac(new Date(s+'T00:00:00Z'));document.getElementById('reading').innerHTML=`<strong>✦ Your cosmic signature</strong><br>Zodiac sign: <strong>${sign}</strong><br>Numerology life path: <strong>${lifePath(s)}</strong><br><span style="font-size:11px">These are symbolic conversation starters, not scientific measures of compatibility.</span>`};function saveProfile(e){e.preventDefault();me={name:document.getElementById('yourName').value,birthday:document.getElementById('birthday').value,city:document.getElementById('city').value,seeking:document.getElementById('seeking').value};localStorage.setItem('cm-me',JSON.stringify(me));showReading();toast('Your cosmic profile was saved ✦')};document.getElementById('birthday').addEventListener('change',showReading);render();if(location.hash&&['#discover','#stories','#matches','#profile','#advertise'].includes(location.hash)){switchTab(location.hash.slice(1));}

let selectedPhotos=[];
function previewPhotos(event){
 const files=Array.from(event.target.files||[]).filter(f=>f.type.startsWith('image/')).slice(0,6);
 selectedPhotos.forEach(url=>URL.revokeObjectURL(url));selectedPhotos=files.map(f=>URL.createObjectURL(f));renderPhotos();
 if(files.length)toast(files.length+' photo'+(files.length===1?'':'s')+' selected ✦');
}
function clearPhotos(){selectedPhotos.forEach(url=>URL.revokeObjectURL(url));selectedPhotos=[];document.getElementById('photoInput').value='';renderPhotos()}
function renderPhotos(){document.getElementById('photoGrid').innerHTML=Array.from({length:6},(_,i)=>'<div class="photo-slot">'+(selectedPhotos[i]?'<img alt="Selected profile photo '+(i+1)+'" src="'+selectedPhotos[i]+'"><span class="slot-label">'+(i===0?'Main photo':'Photo '+(i+1))+'</span>':i===0?'Main photo':'+')+'</div>').join('')}
function submitAdRequest(e){e.preventDefault();const name=document.getElementById('adBusiness').value.trim();const placement=document.getElementById('adPlacement').value;document.getElementById('adResponse').textContent='✦ Preview ready for '+name+' — '+placement+'. This request has NOT been sent. A real launch needs a server, advertiser accounts, and payment processing.';toast('Advertising request preview created ✦')}
renderPhotos();

// Stories feature: browser-only demonstration; never claims server-side delivery.
const STORY_KEY='cm-story-v2';
const PRIVACY_KEY='cm-story-privacy-v2';
const demoStories=[
 {id:'demo-maya',name:'Maya',emoji:'🌙',city:'Vancouver',sign:'Pisces',path:7,score:96,caption:'A sunset and a little bit of magic ✨',created:Date.now()-35*60000,audience:'public',demo:true,views:12,replies:[]},
 {id:'demo-jordan',name:'Jordan',emoji:'✨',city:'Burnaby',sign:'Libra',path:3,score:93,caption:'Live music tonight — who else loves spontaneous plans?',created:Date.now()-90*60000,audience:'public',demo:true,views:8,replies:[]},
 {id:'demo-sam',name:'Sam',emoji:'🌿',city:'North Vancouver',sign:'Taurus',path:6,score:91,caption:'Fresh air is the best reset.',created:Date.now()-150*60000,audience:'public',demo:true,views:7,replies:[]}
];
let storyData=[];try{storyData=JSON.parse(localStorage.getItem(STORY_KEY)||'[]')}catch(e){}
let storyPrivacy={nearby:true,replies:true};try{storyPrivacy={...storyPrivacy,...JSON.parse(localStorage.getItem(PRIVACY_KEY)||'{}')}}catch(e){}
let storyFilter='nearby';const mediaUrls=new Map();
const safe=t=>String(t??'').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
function storyDate(t){return new Date(t).toLocaleDateString('en-CA')===new Date().toLocaleDateString('en-CA')}
function cleanStories(){storyData=storyData.filter(s=>Date.now()-s.created<86400000);localStorage.setItem(STORY_KEY,JSON.stringify(storyData))}
function publicPostsToday(){return storyData.filter(s=>s.audience==='public' && storyDate(s.created)).length}
function openStoryHub(f){storyFilter=f;location.hash='stories';switchTab('stories');renderStories();if(f==='mine')openStoryPicker();else window.scrollTo({top:0,behavior:'smooth'})}
function renderHomeStories(){
 const box=document.getElementById('homeStoryRow');if(!box)return;
 const matched=demoStories.filter(s=>liked.some(i=>people[i].name===s.name));
 const bubbles=[{emoji:'＋',name:'Your Story',filter:'mine',mine:true},{emoji:'🌎',name:'Public',filter:'nearby'},{emoji:'✈️',name:'Travel',filter:'nearby'},...matched.map(s=>({emoji:s.emoji,name:s.name,filter:'matches'}))];
 box.innerHTML=bubbles.map(b=>`<button type="button" class="home-story" onclick="openStoryHub('${b.filter}')" aria-label="Open ${b.name} Stories"><span class="home-story-ring ${b.mine?'mine':''}"><span>${b.emoji}</span></span><span class="home-story-label">${b.name}</span></button>`).join('');
}
function setStoryFilter(f){storyFilter=f;renderStories()}
function saveStoryPrivacy(){storyPrivacy={nearby:document.getElementById('showNearby').checked,replies:document.getElementById('allowReplies').checked};localStorage.setItem(PRIVACY_KEY,JSON.stringify(storyPrivacy));renderStories();toast('Story privacy updated ✦')}
function postStory(){
 cleanStories();const caption=document.getElementById('storyCaption').value.trim();const audience=document.getElementById('storyAudience').value;const file=selectedStoryFile;
 if(!caption&&!file){toast('Add a caption or media first');return}
 if(audience==='public'&&!storyPrivacy.nearby){toast('Enable Nearby visibility, or choose Matches only');return}
 if(audience==='public'&&document.getElementById('storyTravel').checked&&storyData.some(x=>x.audience==='public'&&x.travel&&storyDate(x.created))){toast('One public Travel Story per day');return}
 if(audience==='public'&&publicPostsToday()>=2){toast('Two public Stories per day — try Matches only');return}
 if(file&&file.size>20*1024*1024){toast('Please choose media under 20 MB for this demo');return}
 const s={id:'mine-'+Date.now()+'-'+Math.floor(Math.random()*10000),name:(me?.name||document.getElementById('yourName').value||'You'),emoji:'✦',city:(document.getElementById('storyCity').value.trim()||me?.city||'Your area'),travel:audience==='public'&&document.getElementById('storyTravel').checked,sign:zodiac(new Date((me?.birthday||'1996-07-15')+'T00:00:00Z')),path:lifePath(me?.birthday||'1996-07-15'),score:null,caption,created:Date.now(),audience,demo:false,views:0,replies:[]};
 if(file)mediaUrls.set(s.id,{url:URL.createObjectURL(file),type:file.type});
 storyData.unshift(s);try{localStorage.setItem(STORY_KEY,JSON.stringify(storyData))}catch(e){storyData.shift();toast('Not enough browser storage to save');return}
 document.getElementById('storyCaption').value='';selectedStoryFile=null;document.getElementById('storyCamera').value='';document.getElementById('storyGallery').value='';document.getElementById('storyMediaPreview').textContent='No media selected';document.getElementById('storyVisualPreview').innerHTML='';document.getElementById('storyComposer').classList.remove('composer-open');storyFilter='mine';renderStories();toast('Story posted in this demo ✦');
}
function recordStoryView(id){let s=demoStories.find(x=>x.id===id);if(!s)return;toast('Story viewed ✦ (demo)');s.views++;renderStories()}
function replyToStory(id){const el=document.getElementById('reply-'+id);if(!el)return;const reply=el.value.trim();if(!reply)return;const s=demoStories.find(x=>x.id===id);if(!s)return;toast('Private reply previewed locally ✦');el.value='';s.replies.push({name:me?.name||'You',text:reply});renderStories()}
function removeStory(id){const i=storyData.findIndex(s=>s.id===id);if(i===-1)return;storyData.splice(i,1);if(mediaUrls.has(id)){URL.revokeObjectURL(mediaUrls.get(id).url);mediaUrls.delete(id)}localStorage.setItem(STORY_KEY,JSON.stringify(storyData));renderStories();toast('Story removed')}
function sampleView(id){const s=storyData.find(x=>x.id===id);if(!s)return;s.views++;if(storyPrivacy.replies&&s.views%2===1)s.replies.push({name:'Maya (demo)',text:'Love this energy ✨'});localStorage.setItem(STORY_KEY,JSON.stringify(storyData));renderStories()}
function renderStories(){
 cleanStories();document.getElementById('showNearby').checked=storyPrivacy.nearby;document.getElementById('allowReplies').checked=storyPrivacy.replies;
 const remaining=Math.max(0,2-publicPostsToday());document.getElementById('storyQuota').textContent=remaining+' of 2 public Stories remaining today';
 for(const f of ['nearby','matches','mine'])document.getElementById(f+'Filter').classList.toggle('active',storyFilter===f);
 const list=storyFilter==='mine'?storyData:storyFilter==='matches'?[...demoStories.filter(s=>liked.some(i=>people[i].name===s.name)),...storyData.filter(s=>s.audience==='matches')]:[...demoStories,...(storyPrivacy.nearby?storyData.filter(s=>s.audience==='public'):[])];
 document.getElementById('storyFeed').innerHTML=list.map(s=>{
 const mine=storyData.includes(s),media=mediaUrls.get(s.id);
 const mediastr=media?(media.type.startsWith('video/')?`<video controls playsinline src="${media.url}"></video>`:`<img alt="Story attachment" src="${media.url}">`):'';
 const replies=(s.replies||[]).map(r=>`<div class="viewer"><strong>${safe(r.name)}</strong><small>↳ ${safe(r.text)}</small></div>`).join('');
 const acts=mine?`<div class="story-actions"><button type="button" onclick="sampleView('${s.id}')">👁 ${s.views} views · Simulate view</button><button type="button" onclick="removeStory('${s.id}')">Delete</button></div><div class="story-views"><strong>Story viewers and private replies</strong><div class="muted">Demo viewer activity — comments show here, not in Messages.</div>${replies}${s.views&&!replies?'<div class="viewer">Sample viewer · Seen</div>':''}</div>`:
 `<div class="story-actions"><button type="button" onclick="recordStoryView('${s.id}')">👁 View Story</button></div>${storyPrivacy.replies?`<div class="inline-reply"><input id="reply-${s.id}" maxlength="160" placeholder="Reply privately to this Story"><button type="button" onclick="replyToStory('${s.id}')">Reply</button></div>`:'<div class="muted">Story replies disabled in your demo settings.</div>'}`;
 return `<article class="story-item"><div class="story-title"><div class="story-face">${s.emoji}</div><div><strong>${safe(s.name)}</strong> ${s.score?`<span class="pill">${s.score}% spark</span>`:''}<div class="story-meta">${safe(s.city)} · ${safe(s.sign)} · Life path ${s.path} · ${s.audience==='public'?(s.travel?'✈ Travel Story':'Public'):'Matches only'}</div></div></div><div class="story-body">${safe(s.caption)}${mediastr}</div><div class="story-meta">${s.demo?'Sample story · ':''}Expires ${new Date(s.created+86400000).toLocaleTimeString([],{hour:'numeric',minute:'2-digit'})}</div>${acts}</article>`;
 }).join('')||'<div class="story-empty">No Stories in this view yet. Explore Nearby or add your own.</div>';
}

renderStories();renderHomeStories();

let connectionMode=localStorage.getItem('cm-mode')||'dating';
const modeProfiles={
 friendship:[{name:'Taylor',age:28,city:'Vancouver',sign:'Gemini',path:5,score:94,bio:'Looking for hiking buddies, art nights and genuine friendships.',insight:'Shared curiosity could spark a great friendship.',colors:['#468d91','#24234e'],emoji:'🌿'}],
 business:[{name:'North Star Studio',age:'',city:'Vancouver',sign:'Libra',path:8,score:92,bio:'Creative studio seeking collaborators and new partnerships.',insight:'Your working styles may complement each other.',colors:['#7962ae','#1c3346'],emoji:'💼'}]
};
const originalPeople=people.slice();
function setMode(mode){connectionMode=mode;localStorage.setItem('cm-mode',mode);document.querySelectorAll('[data-mode]').forEach(b=>b.classList.toggle('selected',b.dataset.mode===mode));people.splice(0,people.length,...(modeProfiles[mode]||originalPeople));index=0;liked=[];document.querySelector('.swipe-intro h1').textContent=mode==='business'?'Connect with purpose ✦':mode==='friendship'?'Find your people ✧':'Written in the stars ✧';document.querySelector('.swipe-intro p').textContent=mode==='business'?'Discover potential partners and collaborators.':mode==='friendship'?'Find friends who share your frequency.':'Meet someone who aligns with your universe. Swipe to connect.';render();}
function saveBusiness(e){e.preventDefault();const ids=['bizName','bizIndustry','bizLocation','bizAbout','bizServices','bizLink','bizSeeking'];const data={};ids.forEach(id=>data[id]=document.getElementById(id).value);localStorage.setItem('cm-business',JSON.stringify(data));toast('Business profile saved ✦');}
let businessPhotoUrls=[];
function clearBusinessPhotos(){businessPhotoUrls.forEach(URL.revokeObjectURL);businessPhotoUrls=[];document.getElementById('businessPhotoInput').value='';renderBusinessPhotos();}
function renderBusinessPhotos(){const g=document.getElementById('businessPhotoGrid');g.innerHTML='';for(let i=0;i<3;i++){const d=document.createElement('div');d.className='photo-slot';if(businessPhotoUrls[i]){const img=document.createElement('img');img.src=businessPhotoUrls[i];img.alt='Business photo '+(i+1);img.style.cssText='width:100%;height:100%;object-fit:cover;border-radius:12px';d.appendChild(img)}else d.textContent=i===0?'Main photo':'Photo '+(i+1);g.appendChild(d)}}
function previewBusinessPhotos(e){const fs=Array.from(e.target.files||[]).filter(f=>f.type.startsWith('image/'));if(fs.length>3)toast('Only the first 3 business photos are shown');businessPhotoUrls.forEach(URL.revokeObjectURL);businessPhotoUrls=fs.slice(0,3).map(f=>URL.createObjectURL(f));renderBusinessPhotos();}
function loadBusiness(){let data;try{data=JSON.parse(localStorage.getItem('cm-business')||'{}')}catch(e){data={}}Object.entries(data).forEach(([id,value])=>{const el=document.getElementById(id);if(el)el.value=value;});}

let travelEnabled=localStorage.getItem('cm-travel-enabled')==='true';
let travelCity=localStorage.getItem('cm-travel-city')||'';
let selectedStoryFile=null;
const travelPeople={
 'toronto':[{name:'Avery',age:28,city:'Toronto, ON',sign:'Aquarius',path:3,score:93,bio:'Toronto creative who loves good conversations and spontaneous plans.',insight:'Your interests could open up an exciting connection.',colors:['#8061b4','#322050'],emoji:'🌆'}],
 'montreal':[{name:'Camille',age:27,city:'Montreal, QC',sign:'Leo',path:6,score:91,bio:'Art, music, and discovering new places.',insight:'Shared curiosity could make your trip memorable.',colors:['#b16888','#33264d'],emoji:'🎨'}]
};
function travelCandidates(){
 const city=travelCity.trim();if(!travelEnabled||!city)return null;
 const key=city.toLowerCase().split(',')[0].trim();
 const known=travelPeople[key];
 if(known)return known.map(x=>({...x}));
 return [{name:'Local Explorer',age:29,city,sign:'Libra',path:7,score:90,bio:'Sample profile for '+city+' — discover local connections.',insight:'A shared interest in new experiences could bring you together.',colors:['#607aa5','#28264c'],emoji:'✈️'}];
}
function applyDiscoverCity(){
 const pool=travelCandidates()||(modeProfiles[connectionMode]||originalPeople);
 people.splice(0,people.length,...pool);
 index=0;liked=[];
 render();
 const status=document.getElementById('travelStatus');
 status.textContent=travelEnabled&&travelCity.trim()?'✈ Discovering sample profiles in '+travelCity.trim()+' · '+connectionMode:'Discovering in your home city';
 document.getElementById('travelEnabled').checked=travelEnabled;
 document.getElementById('travelCity').value=travelCity;
 if(!document.getElementById('storyCity').dataset.edited){document.getElementById('storyCity').value=travelEnabled&&travelCity.trim()?travelCity.trim():(me?.city||document.getElementById('city').value||'Vancouver, BC');}
 updateStoryCity();
}
function toggleTravel(value){travelEnabled=value;localStorage.setItem('cm-travel-enabled',String(value));applyDiscoverCity();}
function updateTravelCity(value){travelCity=value;localStorage.setItem('cm-travel-city',value);applyDiscoverCity();}
function updateStoryCity(){const el=document.getElementById('storyCity');el.dataset.edited='true';document.getElementById('storyCityStatus').textContent='Public audience: '+(el.value.trim()||'Choose a city')+(document.getElementById('storyTravel').checked?' · ✈ Travel Story':'')+' (demo only)';}
let storyPreviewURL=null;
function openStoryPicker(){document.getElementById('storyPicker').classList.add('open')}
function closeStoryPicker(){document.getElementById('storyPicker').classList.remove('open')}
function pickStoryMedia(source){closeStoryPicker();const el=document.getElementById(source==='camera'?'storyCamera':'storyGallery');el.click()}
function chooseStoryMedia(input){
 selectedStoryFile=input.files&&input.files[0]||null;
 if(storyPreviewURL){URL.revokeObjectURL(storyPreviewURL);storyPreviewURL=null;}
 const preview=document.getElementById('storyVisualPreview');preview.innerHTML='';
 document.getElementById('storyMediaPreview').textContent=selectedStoryFile?'Selected: '+selectedStoryFile.name:'No media selected';
 if(!selectedStoryFile)return;
 if(selectedStoryFile.size>20*1024*1024){toast('Please choose media under 20 MB');selectedStoryFile=null;return;}
 storyPreviewURL=URL.createObjectURL(selectedStoryFile);
 const media=document.createElement(selectedStoryFile.type.startsWith('video/')?'video':'img');media.src=storyPreviewURL;media.className='story-media-preview';if(media.tagName==='VIDEO'){media.controls=true;media.playsInline=true;}preview.appendChild(media);
 document.getElementById('storyComposer').classList.add('composer-open');document.getElementById('storyComposer').scrollIntoView({behavior:'smooth',block:'start'});
}
const baseSetMode=setMode;
setMode=function(mode){baseSetMode(mode);applyDiscoverCity();};
loadBusiness();setMode(connectionMode);


// 18+ signup validation. Client-side only; enforce on a secure backend for production.
function cosmicAdult(dob){
 if(!/^\d{4}-\d{2}-\d{2}$/.test(dob||''))return false;
 const parts=dob.split('-').map(Number),y=parts[0],m=parts[1],d=parts[2];
 const birth=new Date(y,m-1,d),today=new Date();
 if(birth.getFullYear()!==y||birth.getMonth()!==m-1||birth.getDate()!==d||birth>today)return false;
 let age=today.getFullYear()-y;if(today.getMonth()+1<m||(today.getMonth()+1===m&&today.getDate()<d))age--;
 return age>=18;
}
function adultCutoff(){const t=new Date();return [t.getFullYear()-18,String(t.getMonth()+1).padStart(2,'0'),String(t.getDate()).padStart(2,'0')].join('-')}
const signupGate=document.getElementById('ageGate');
const signupBirthday=document.getElementById('signupBirthday');
signupBirthday.max=adultCutoff();
document.getElementById('birthday').max=adultCutoff();
if(localStorage.getItem('cm-age-confirmed')!=='true'||!me||!cosmicAdult(me.birthday)){
 signupGate.hidden=false;
 document.getElementById('signupName').value=me?.name||'';
 signupBirthday.value=me?.birthday||'';
}
document.getElementById('ageSignupForm').addEventListener('submit',function(e){
 e.preventDefault();const dob=signupBirthday.value,err=document.getElementById('signupAgeError');
 if(!cosmicAdult(dob)){err.textContent='You must be 18 or older to join Cosmic Match.';return}
 if(!document.getElementById('signupAdultConfirm').checked){err.textContent='Please confirm you are at least 18.';return}
 const n=document.getElementById('signupName').value.trim();if(!n){err.textContent='Please enter your name.';return}
 me={...me,name:n,birthday:dob,city:me?.city||'Vancouver, BC',seeking:me?.seeking||'A meaningful connection'};
 localStorage.setItem('cm-me',JSON.stringify(me));localStorage.setItem('cm-age-confirmed','true');
 document.getElementById('yourName').value=n;document.getElementById('birthday').value=dob;
 showReading();signupGate.hidden=true;toast('Welcome to Cosmic Match ✦');
});
const originalSaveProfile=saveProfile;
saveProfile=function(e){
 if(!cosmicAdult(document.getElementById('birthday').value)){
  e.preventDefault();toast('Cosmic Match is for ages 18 and older');return;
 }
 originalSaveProfile(e);
};
</script><script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<section id="cmAuth" class="age-gate" style="z-index:2000">
 <div class="age-card"><div class="eyebrow">Cosmic Match · Phase 2 test</div><h2>Welcome to Cosmic Match ✦</h2><p>Sign in or create a test account. You must be 18 or older.</p>
 <form id="cmAuthForm"><label>Email<input id="cmEmail" type="email" autocomplete="email" required style="width:100%"></label><label>Password<input id="cmPassword" type="password" autocomplete="current-password" minlength="8" required style="width:100%"></label><label><input id="cmAdult" type="checkbox"> I confirm I am 18 or older (required for registration)</label><button class="cta" type="submit">Sign in</button><button class="cta" type="button" id="cmRegister">Create account</button></form><p id="cmAuthStatus" role="status" aria-live="polite"></p><p class="age-hint">Private test only. Profiles, Stories and messaging are still demo features. Do not enter sensitive profile details.</p></div>
</section>
<div id="cmSessionBar" hidden style="position:fixed;top:0;right:0;z-index:1100;background:#24153c;padding:6px 10px;border-radius:0 0 0 12px"><button id="cmLogout" type="button">Sign out</button></div>
<script>
(()=>{
 const byId=id=>document.getElementById(id), status=byId('cmAuthStatus'), form=byId('cmAuthForm');
 if(!window.supabase){status.textContent='Could not load Supabase. Check your internet connection and reload.';return;}
 const client=window.supabase.createClient('https://odvuuveaojhuhkwvqfgk.supabase.co','sb_publishable_FFkPxAVgmgik7mCjdnHMKQ_TaM6IPR8');
 function show(session){byId('cmAuth').hidden=!!session;byId('cmSessionBar').hidden=!session; if(session)byId('cmPassword').value='';}
 client.auth.onAuthStateChange((_event,session)=>show(session));
 client.auth.getSession().then(({data,error})=>{if(error)status.textContent=error.message;else show(data.session);}).catch(e=>status.textContent=e.message);
 async function submit(register){
  if(!form.reportValidity())return;
  if(register&&!byId('cmAdult').checked){status.textContent='Please confirm you are 18 or older.';return;}
  const buttons=form.querySelectorAll('button');buttons.forEach(b=>b.disabled=true);status.textContent='Contacting Supabase…';
  try{const credentials={email:byId('cmEmail').value.trim(),password:byId('cmPassword').value};
   const {data,error}=register?await client.auth.signUp(credentials):await client.auth.signInWithPassword(credentials);
   if(error)throw error;
   status.textContent=data.session?'Signed in.':'Check your email for a confirmation link, then return and sign in.';
   if(data.session)show(data.session);
  }catch(e){status.textContent=e.message||'Unable to connect.';}finally{buttons.forEach(b=>b.disabled=false);}
 }
 form.addEventListener('submit',e=>{e.preventDefault();submit(false);});byId('cmRegister').addEventListener('click',()=>submit(true));
 byId('cmLogout').addEventListener('click',async()=>{try{const {error}=await client.auth.signOut();if(error)throw error;show(null);status.textContent='Signed out.';}catch(e){alert(e.message);}});
})();
</script>
</body></html>
